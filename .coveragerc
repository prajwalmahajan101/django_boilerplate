[run]
source = apps
branch = True
parallel = True
concurrency = multiprocessing,thread
omit =
    */migrations/*
    */tests/*
    */__pycache__/*
    */apps.py
    */admin.py
    apps/*/urls.py
    config/*
    # Dormant modules — ship in-tree for downstream forks, zero in-tree
    # callers today, omitted so they don't drag the floor. Each carries a
    # ``Dormant:`` callout in its docstring. The dormant-import AST gate
    # scheduled for M3 will fail the build if anything under ``apps/``
    # starts importing one of these without a matching integration test.
    # Keep this list in sync with the docstring callouts.
    apps/core/utils/s3.py
    apps/core/utils/data.py
    apps/core/utils/filters.py
    apps/core/utils/valkey.py
    apps/core/utils/ses.py
    apps/core/utils/function_logger.py
    apps/core/utils/aws.py
    apps/core/middleware/metrics_middleware.py

[report]
show_missing = True
skip_covered = False
skip_empty = True
precision = 2
fail_under = 70
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.

[html]
directory = htmlcov
title = Django Boilerplate Coverage

[xml]
output = coverage.xml
