# ===========================================================================
# Django Boilerplate — Environment Configuration
# ===========================================================================
# Copy this file to .env.local / .env.dev / .env.prod and fill in values.
# Never commit real secrets — use AWS Secrets Manager for dev/prod.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_ENV=local                    # local | dev | uat | prod | test
SECRET_KEY=change-me-in-production
RESILIENCE_CRYPTO__FIELD_ENCRYPTION_KEY=   # Required in prod — resilience-kit FernetCipher refuses to start otherwise (ADR-0008). 32-byte base64. Set RESILIENCE_CRYPTO__ENVIRONMENT=dev for local/test.
# FIELD_ENCRYPTION_KEY=             # Legacy name — accepted via legacy_env_alias() with DeprecationWarning. Drop after deploy migration.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=600

# ---------------------------------------------------------------------------
# Valkey (Redis-compatible) — single instance, three roles via logical DBs:
#   DB 0 = Celery broker (use redis:// scheme — Celery's redis transport)
#   DB 2 = cache         (django-valkey, valkey:// scheme)
#   DB 3 = rate limit + circuit breaker (django-valkey, valkey:// scheme)
# ---------------------------------------------------------------------------
VALKEY_CACHE_URL=valkey://valkey:6379/2
VALKEY_RATE_LIMIT_URL=valkey://valkey:6379/3
# VALKEY_PASSWORD=

# ---------------------------------------------------------------------------
# Celery (broker on Valkey DB 0; results in Django DB)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_WORKER_CONCURRENCY=4
# CELERY_APP_NAME=app                 # Worker / queue identity. Change per service.

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_SANITIZE_ENABLED=true
# LOG_MAX_STRING_LENGTH=200
# LOG_MASK_PATTERN=
# LOG_MAX_DICT_KEYS=20
# LOG_MAX_LIST_ITEMS=10
# LOG_EXCLUDED_FIELDS=password,secret_ref,api_key,private_key,access_token

# ---------------------------------------------------------------------------
# Resilience kit (rate limit, circuit breaker, retry, SSRF, audit)
# ---------------------------------------------------------------------------
# All resilience tuning now lives behind RESILIENCE_* env vars consumed by
# pydantic-settings inside the kit. The boilerplate-shaped legacy names on
# the right (commented out) still work — config/settings/base.py calls
# resilience_kit.runtime.legacy_env_alias() at import time, which copies
# any set legacy var to its RESILIENCE_* equivalent and emits a
# DeprecationWarning per var. Prefer the RESILIENCE_* shape going forward.
#
# Throttle tier rates (per-scope; format: "<count>/<period>")
# RESILIENCE_DEFAULTS__THROTTLE__ANON_RATE=100/hour       # legacy: RATE_LIMIT_ANON
# RESILIENCE_DEFAULTS__THROTTLE__AUTH_RATE=20/hour        # legacy: RATE_LIMIT_AUTH
# RESILIENCE_DEFAULTS__THROTTLE__BURST_RATE=10/second     # legacy: RATE_LIMIT_BURST
#
# Circuit-breaker defaults (per service; per-service overrides via RESILIENCE["services"])
# RESILIENCE_DEFAULTS__CIRCUIT_BREAKER__FAIL_MAX=5         # legacy: CIRCUIT_BREAKER_FAIL_MAX
# RESILIENCE_DEFAULTS__CIRCUIT_BREAKER__RESET_TIMEOUT=30   # legacy: CIRCUIT_BREAKER_RESET_TIMEOUT
#
# Retry defaults (tenacity-backed)
# RESILIENCE_DEFAULTS__RETRY__MAX_ATTEMPTS=3
# RESILIENCE_DEFAULTS__RETRY__WAIT_MIN=1
# RESILIENCE_DEFAULTS__RETRY__WAIT_MAX=10
#
# Recovery monitor (post-Valkey-blip backend re-probe interval, seconds)
# RESILIENCE_RECOVERY__PROBE_INTERVAL_SECONDS=5            # legacy: RECOVERY_PROBE_INTERVAL
#
# SSRF guard (HTTP client allow-list and private-IP block)
# RESILIENCE_SSRF__OUTBOUND_ALLOWLIST=["partner.example",".trusted.io"]   # legacy: OUTBOUND_ALLOWLIST / SSRF_ALLOWLIST (now JSON list, not comma-separated)
# RESILIENCE_SSRF__BLOCK_PRIVATE_IPS=true                  # legacy: BLOCK_PRIVATE_IPS
#
# Crypto environment (controls Fernet's prod-without-key refusal)
# RESILIENCE_CRYPTO__ENVIRONMENT=prod                      # one of: dev | prod. Set 'dev' locally; 'prod' fails fast without RESILIENCE_CRYPTO__FIELD_ENCRYPTION_KEY.
#
# Redis/Valkey URL for kit-side state (breakers, throttle buckets)
# RESILIENCE_REDIS_URL=valkey://valkey:6379/3              # legacy: REDIS_URL
#
# Audit sink ("stdlib_logging" | "postgres" | importable string)
# RESILIENCE_AUDIT__SINK=stdlib_logging                    # legacy: AUDIT_SINK

# ---------------------------------------------------------------------------
# JWT / Auth
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=                    # Dedicated signing key (falls back to SECRET_KEY)

# ---------------------------------------------------------------------------
# Google OAuth2 (django-allauth)
# ---------------------------------------------------------------------------
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
# USE_X_FORWARDED_FOR=True

# ---------------------------------------------------------------------------
# Gunicorn (gthread worker class)
# ---------------------------------------------------------------------------
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# APP_VERSION=unknown

# ---------------------------------------------------------------------------
# AWS credentials (required for S3 + SES + CloudWatch when not running on
# an instance with an attached IAM role)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# CloudWatch (optional)
# ---------------------------------------------------------------------------
# CLOUDWATCH_ENABLED=TRUE
# CLOUDWATCH_LOG_GROUP=app

# ---------------------------------------------------------------------------
# AWS Secrets Manager (dev/prod only)
# ---------------------------------------------------------------------------
# DJANGO_AWS_FETCH_SECRETS=True
# AWS_SECRET_NAME=app/prod

# ---------------------------------------------------------------------------
# SES (Email)
# ---------------------------------------------------------------------------
# SES_SENDER_EMAIL=noreply@example.com
# SES_REGION=

# ---------------------------------------------------------------------------
# Assets (S3-backed file attachments)
# ---------------------------------------------------------------------------
# ASSET_S3_BUCKET=app-assets
# ASSET_S3_KEY_PREFIX=assets/
# ASSET_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# Flower (Celery monitoring)
# ---------------------------------------------------------------------------
# FLOWER_USER=admin
# FLOWER_PASSWORD=secret

# ---------------------------------------------------------------------------
# Exposed ports (host-side, docker-compose)
# ---------------------------------------------------------------------------
WEB_PORT=8000
VALKEY_PORT=6379

# ---------------------------------------------------------------------------
# Deployment (ECR / Gunicorn)
# ---------------------------------------------------------------------------
# ECR_REGISTRY=
# IMAGE_TAG=dev

# ---------------------------------------------------------------------------
# Gunicorn capacity tuning (Commit 2 — scalability hardening)
# ---------------------------------------------------------------------------
# Worker / thread sizing
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=130
# Recycle each worker after this many requests (with jitter) to bound
# per-thread memory growth from long-lived gthread state.
# GUNICORN_MAX_REQUESTS=10000
# GUNICORN_MAX_REQUESTS_JITTER=500
# Listen-socket backlog — raise if the OS listen queue overflows under
# sustained bursts; lower if you want faster rejection of excess load.
# GUNICORN_BACKLOG=2048

# ---------------------------------------------------------------------------
# Celery tunables
# ---------------------------------------------------------------------------
# CELERY_TASK_TIME_LIMIT=1800        # seconds — hard SIGKILL after this
# CELERY_TASK_SOFT_TIME_LIMIT=1500   # seconds — raises SoftTimeLimitExceeded
# CELERY_WORKER_CONCURRENCY=4
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Per-task event emission adds broker traffic — turn OFF in prod once
# observability moves from Flower to metrics, ON in dev for visibility.
# CELERY_SEND_EVENTS=true
